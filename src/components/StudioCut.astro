---
import { cinemaNotes, href, pad, shortDate } from '../lib/site';

// Keep the homepage feature focused: the two newest pieces lead into the full Hot Takes archive.
const takes = [...cinemaNotes].reverse().slice(0, 2);
const total = cinemaNotes.length;
const archiveHref = href('hot-takes/');
---
<section class="studio-cut" id="hot-takes-studio" aria-labelledby="studio-title">
  <div class="studio-shell">
    <div class="studio-topline">
      <span class="mono studio-topline-left">The cinema desk</span>
      <span class="mono studio-topline-right">Tollygunge · Kolkata</span>
    </div>

    <div class="studio-feature">
      <div class="studio-copy">
        <div class="studio-line mono"><span>Line 04</span><i aria-hidden="true">/</i><span>The studio cut</span></div>
        <h2 id="studio-title">Hot Takes</h2>
        <p class="studio-subtitle">From the studio floor.</p>
        <p class="studio-intro">Cinema, read closely. The choices behind a frame, the conviction behind a performance, the story beneath the screenplay. Not just whether a film works, but <em>why</em>.</p>
        <p class="studio-method mono">Observation <b>→</b> interpretation <b>→</b> conviction</p>
        <a class="studio-enter" href={archiveHref} data-cursor="link">
          <span>Enter the screening room</span><span class="studio-enter-arrow" aria-hidden="true">↗</span>
        </a>
      </div>

      <figure class="studio-art" aria-label="A warmly lit film studio set with a cinema spotlight, clapperboard and film reel">
        <svg viewBox="0 0 760 520" class="studio-artwork" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
          <defs>
            <linearGradient id="sc-bg" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#211a12"/>
              <stop offset=".52" stop-color="#100e0c"/>
              <stop offset="1" stop-color="#24140f"/>
            </linearGradient>
            <linearGradient id="sc-beam" x1="1" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#f6c26a" stop-opacity=".42"/>
              <stop offset=".45" stop-color="#e1a54d" stop-opacity=".13"/>
              <stop offset="1" stop-color="#d78c48" stop-opacity="0"/>
            </linearGradient>
            <radialGradient id="sc-lamp">
              <stop offset="0" stop-color="#fff3c4"/>
              <stop offset=".35" stop-color="#ffd58a"/>
              <stop offset=".75" stop-color="#ed9e43" stop-opacity=".7"/>
              <stop offset="1" stop-color="#ed9e43" stop-opacity="0"/>
            </radialGradient>
            <linearGradient id="sc-metal" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#8c6a3e"/>
              <stop offset=".48" stop-color="#30271d"/>
              <stop offset="1" stop-color="#100e0b"/>
            </linearGradient>
            <linearGradient id="sc-board" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#5b4730"/>
              <stop offset="1" stop-color="#211b14"/>
            </linearGradient>
            <filter id="sc-glow" x="-100%" y="-100%" width="300%" height="300%">
              <feGaussianBlur stdDeviation="12"/>
            </filter>
            <pattern id="sc-grain" width="90" height="90" patternUnits="userSpaceOnUse">
              <circle cx="8" cy="12" r="1" fill="#f6dba5" opacity=".18"/>
              <circle cx="51" cy="43" r=".8" fill="#f6dba5" opacity=".12"/>
              <circle cx="74" cy="75" r=".7" fill="#f6dba5" opacity=".16"/>
            </pattern>
          </defs>

          <rect width="760" height="520" fill="url(#sc-bg)"/>
          <g opacity=".27" stroke="#8e795a" fill="none">
            <path d="M0 70H760M0 130H760M0 190H760M0 250H760M0 310H760M0 370H760"/>
            <path d="M90 0V390M180 0V390M270 0V390M360 0V390M450 0V390M540 0V390M630 0V390"/>
          </g>
          <path d="M602 66L150 410L760 472V98Z" fill="url(#sc-beam)"/>
          <path d="M0 410L760 366V520H0Z" fill="#0a0908" opacity=".72"/>
          <path d="M0 430L760 392M0 470L760 434M0 505L760 473" stroke="#7f6948" stroke-opacity=".25" fill="none"/>

          <g opacity=".48" stroke="#8d806e" stroke-width="5" fill="none">
            <path d="M84 360L122 215L160 360M105 286H145M95 324H151"/>
            <path d="M118 215L118 185L168 185L168 215"/>
            <path d="M154 360L190 238L222 360M176 294H208"/>
          </g>
          <g opacity=".42" fill="#090908">
            <path d="M175 385L208 310L238 385Z"/>
            <path d="M190 310L224 296L254 310V332H190Z"/>
          </g>

          <!-- Warm studio spotlight and its stand -->
          <g transform="translate(528 20)">
            <path d="M92 0L110 40L102 152M110 152L70 240M110 152L160 241" stroke="#826542" stroke-width="6" fill="none" stroke-linecap="round"/>
            <path d="M24 22L114 0L168 38L158 126L71 150L14 104Z" fill="url(#sc-metal)" stroke="#b18a50" stroke-width="3"/>
            <path d="M34 30L116 12L151 42L142 108L74 128L28 92Z" fill="#1b1712" stroke="#6c5535" stroke-width="2"/>
            <circle cx="84" cy="72" r="72" fill="#f2b35a" opacity=".22" filter="url(#sc-glow)"/>
            <circle cx="84" cy="72" r="48" fill="url(#sc-lamp)"/>
            <circle cx="84" cy="72" r="24" fill="#ffe7aa"/>
            <path d="M17 36L0 25M15 99L-4 109M154 31L172 17M151 113L171 126" stroke="#c49a5c" stroke-width="7" stroke-linecap="round"/>
          </g>

          <!-- Clapperboard on a worn studio apple box -->
          <g transform="translate(326 274) rotate(-4 138 100)">
            <path d="M-12 185H294L311 233H-20Z" fill="#31261a" stroke="#967347" stroke-width="3"/>
            <path d="M0 63L272 42L286 190L12 207Z" fill="url(#sc-board)" stroke="#a37d4b" stroke-width="3"/>
            <path d="M-2 64L270 41L254 0L-13 23Z" fill="#c2a77a" stroke="#d3b78b" stroke-width="3"/>
            <path d="M22 22L48 19L66 57L40 59ZM84 17L110 15L128 52L102 55ZM146 12L172 10L191 47L165 49ZM208 7L234 5L253 42L227 44Z" fill="#30271d"/>
            <path d="M18 113L248 96M20 146L252 129M22 178L254 161" stroke="#c4a875" stroke-opacity=".32" stroke-width="2"/>
            <circle cx="35" cy="91" r="4" fill="#d6b47a"/><circle cx="250" cy="75" r="4" fill="#d6b47a"/>
          </g>

          <!-- Film reel and loose strip -->
          <g transform="translate(644 365)">
            <circle r="84" fill="#1d1913" stroke="#a17c47" stroke-width="9"/>
            <circle r="67" fill="none" stroke="#d4ad70" stroke-opacity=".42" stroke-width="2"/>
            {Array.from({ length: 6 }, (_, i) => {
              const angle = (Math.PI * 2 * i) / 6;
              const x = Math.cos(angle) * 37;
              const y = Math.sin(angle) * 37;
              return <circle cx={x} cy={y} r="12" fill="#0b0a08" stroke="#a98756" stroke-width="2" />;
            })}
            <circle r="12" fill="#b78a4e"/>
          </g>
          <path d="M450 465C505 420 542 460 575 433C606 408 636 436 685 414" fill="none" stroke="#c54d76" stroke-width="6" stroke-linecap="round"/>
          <path d="M450 465C505 420 542 460 575 433C606 408 636 436 685 414" fill="none" stroke="#f17ca1" stroke-opacity=".6" stroke-width="14" filter="url(#sc-glow)"/>
          <rect width="760" height="520" fill="url(#sc-grain)"/>
          <rect x="1" y="1" width="758" height="518" fill="none" stroke="#d0ad71" stroke-opacity=".45" stroke-width="2"/>
        </svg>
        <figcaption class="mono studio-art-caption"><span>On the studio floor</span><span>01 / Kolkata</span></figcaption>
      </figure>
    </div>

    <div class="studio-meter" role="img" aria-label="A glowing marker moves from zero to ten, then returns to zero">
      <div class="studio-meter-head mono"><span>A fresh cut</span><span>0 — 10 — 0</span></div>
      <div class="studio-counter">
        <span class="studio-counter-rail" aria-hidden="true"></span>
        <span class="studio-playhead" aria-hidden="true"></span>
        <ol class="studio-counter-numbers" aria-hidden="true">
          {Array.from({ length: 11 }, (_, i) => <li><span>{i}</span></li>)}
        </ol>
      </div>
    </div>

    <div class="studio-reel-head">
      <div>
        <span class="mono studio-reel-kicker">The current reel</span>
        <h3>Now screening.</h3>
      </div>
      <a class="mono studio-all-link" href={archiveHref} data-cursor="link">All Hot Takes <span aria-hidden="true">→</span></a>
    </div>

    {takes.length > 0 ? (
      <div class="studio-screenings">
        {takes.map((take) => (
          <a class="studio-screening" href={href(take.path)} style={`--take-colour:${take.colour}`} data-cursor="Read" data-wipe={take.colour} data-wipe-to={take.title}>
            <span class="mono studio-screening-meta"><span>Take {pad(take.no)}</span><span>{shortDate(take.date)}</span></span>
            <span class="studio-screening-title">{take.title}</span>
            <span class="studio-screening-summary">{take.summary}</span>
            <span class="studio-screening-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="studio-empty">
        <span class="mono">The first reel is being threaded</span>
        <p>The screening room is ready. The first piece is still taking shape.</p>
      </div>
    )}
    <div class="studio-footline">
      <span class="mono">{pad(total)} {total === 1 ? 'take' : 'takes'} on the reel</span>
      <span class="mono">Independent criticism · Kolkata</span>
    </div>
  </div>
</section>

<style>
  .studio-cut {
    --studio-pink: #ec6f9b;
    --studio-amber: #e5b45d;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(58px, 7.8vw, 112px);
    border-block: 1px solid rgba(236, 228, 210, .13);
    background:
      radial-gradient(ellipse at 78% 20%, rgba(229, 180, 93, .09), transparent 34%),
      radial-gradient(ellipse at 10% 86%, rgba(236, 111, 155, .065), transparent 36%),
      linear-gradient(145deg, #15120e, #0c0b09 62%, #15100e);
    color: var(--paper);
  }
  .studio-cut::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: .22;
    background: repeating-linear-gradient(90deg, transparent 0 56px, rgba(236, 228, 210, .025) 56px 57px);
  }
  .studio-shell {
    width: min(1440px, 100%);
    margin-inline: auto;
    padding-inline: clamp(16px, 2.6vw, 40px);
  }
  .studio-topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-bottom: 13px;
    border-bottom: 1px solid rgba(236, 228, 210, .18);
    color: var(--muted);
  }
  .studio-topline .mono { font-size: 10px; letter-spacing: .17em; }
  .studio-topline-right { color: var(--studio-amber); }
  .studio-feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.03fr);
    gap: clamp(28px, 5vw, 76px);
    align-items: center;
    padding-block: clamp(28px, 4.2vw, 58px) clamp(32px, 4vw, 52px);
  }
  .studio-copy { min-width: 0; }
  .studio-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    color: var(--studio-pink);
    font-size: 12px;
    letter-spacing: .16em;
  }
  .studio-line i { color: var(--muted); font-style: normal; }
  .studio-copy h2 {
    margin: 16px 0 0;
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(54px, 7.2vw, 104px);
    line-height: .88;
    letter-spacing: -.045em;
    text-wrap: balance;
  }
  .studio-subtitle {
    margin: 15px 0 22px;
    color: var(--studio-amber);
    font-family: var(--f-display);
    font-size: clamp(26px, 3vw, 42px);
    font-style: italic;
    line-height: 1;
  }
  .studio-intro {
    max-width: 49ch;
    margin: 0;
    color: var(--paper-dim);
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .studio-intro em { color: var(--paper); }
  .studio-method {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    margin: 22px 0 28px;
    color: var(--muted);
    font-size: 10px;
    letter-spacing: .12em;
  }
  .studio-method b { color: var(--studio-amber); font-weight: 400; }
  .studio-enter {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 11px 0 10px;
    border-bottom: 1px solid var(--studio-amber);
    color: var(--paper);
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: .12em;
    text-transform: uppercase;
    transition: color .3s, border-color .3s;
  }
  .studio-enter-arrow { color: var(--studio-amber); font-size: 20px; line-height: 1; transition: transform .4s; }
  @media (hover: hover) {
    .studio-enter:hover { color: var(--studio-amber); }
    .studio-enter:hover .studio-enter-arrow { transform: translate(3px,-3px); }
  }

  .studio-art {
    position: relative;
    min-width: 0;
    margin: 0;
    aspect-ratio: 1.42 / 1;
    overflow: hidden;
    border: 1px solid rgba(229, 180, 93, .38);
    background: #15100c;
    box-shadow: 0 28px 70px -40px rgba(0, 0, 0, .9), 0 0 42px rgba(229, 180, 93, .065);
  }
  .studio-art::before, .studio-art::after {
    content: '';
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    height: 5px;
    pointer-events: none;
    background: repeating-linear-gradient(90deg, rgba(229,180,93,.78) 0 7px, transparent 7px 19px);
    opacity: .42;
  }
  .studio-art::before { top: 0; }
  .studio-art::after { bottom: 0; }
  .studio-artwork { width: 100%; height: 100%; object-fit: cover; }
  .studio-art-caption {
    position: absolute;
    z-index: 3;
    left: 15px;
    right: 15px;
    bottom: 14px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    color: #f0d7ad;
    font-size: 9px;
    letter-spacing: .15em;
    text-shadow: 0 2px 12px #000;
  }

  .studio-meter {
    position: relative;
    padding: 13px 14px 15px;
    border: 1px solid rgba(229, 180, 93, .34);
    background: linear-gradient(90deg, rgba(236,111,155,.055), rgba(229,180,93,.065), rgba(236,111,155,.055));
    box-shadow: inset 0 0 22px rgba(229, 180, 93, .035);
  }
  .studio-meter-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
    margin-bottom: 11px;
    color: var(--studio-amber);
    font-size: 10px;
    letter-spacing: .16em;
  }
  .studio-counter {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 40px;
    padding-block: 6px;
    background:
      repeating-linear-gradient(90deg, rgba(229,180,93,.12) 0 1px, transparent 1px calc(100% / 11)),
      repeating-linear-gradient(90deg, transparent 0 12px, rgba(229,180,93,.13) 12px 13px, transparent 13px 23px);
    border-block: 1px solid rgba(229,180,93,.23);
  }
  .studio-counter-rail {
    position: absolute;
    z-index: -1;
    top: 50%;
    left: 3.8%;
    right: 3.8%;
    height: 2px;
    background: linear-gradient(90deg, var(--studio-pink), var(--studio-amber), var(--studio-pink));
    opacity: .82;
    transform: translateY(-50%);
  }
  .studio-counter-numbers {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .studio-counter-numbers li {
    flex: 1 1 0;
    min-width: 0;
    text-align: center;
    color: var(--paper-dim);
    font-family: var(--f-mono);
    font-size: clamp(10px, 1vw, 13px);
    line-height: 26px;
    font-variant-numeric: tabular-nums;
  }
  .studio-counter-numbers li:first-child,
  .studio-counter-numbers li:last-child { color: var(--studio-pink); }
  .studio-playhead {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 3.8%;
    width: 14px;
    height: 14px;
    border: 2px solid #ffe4ad;
    border-radius: 50%;
    background: var(--studio-amber);
    box-shadow: 0 0 7px 2px rgba(229,180,93,.68), 0 0 20px 7px rgba(229,180,93,.25);
    transform: translate(-50%, -50%);
    animation: studio-travel 6s cubic-bezier(.45,0,.55,1) infinite alternate;
    will-change: left;
  }
  @keyframes studio-travel {
    from { left: 3.8%; }
    to { left: 96.2%; }
  }

  .studio-reel-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    margin-top: clamp(38px, 5vw, 64px);
    margin-bottom: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(236, 228, 210, .2);
  }
  .studio-reel-kicker {
    color: var(--studio-pink);
    font-size: 10px;
    letter-spacing: .16em;
  }
  .studio-reel-head h3 {
    margin: 7px 0 0;
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(32px, 3.7vw, 52px);
    line-height: .95;
  }
  .studio-all-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    flex: none;
    color: var(--paper-dim);
    font-size: 10px;
    letter-spacing: .1em;
  }
  .studio-all-link span { color: var(--studio-amber); font-size: 18px; transition: transform .35s; }
  @media (hover: hover) { .studio-all-link:hover span { transform: translateX(5px); } }
  .studio-screenings {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2.6vw, 34px);
  }
  .studio-screening {
    --take-colour: var(--studio-amber);
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 11px;
    min-height: 168px;
    padding: 18px 42px 19px 0;
    border-bottom: 1px solid rgba(236, 228, 210, .18);
    transition: border-color .3s;
  }
  .studio-screening::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    width: 60px;
    height: 2px;
    background: var(--take-colour);
    box-shadow: 0 0 12px color-mix(in srgb, var(--take-colour) 55%, transparent);
  }
  .studio-screening-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    color: var(--studio-pink);
    font-size: 10px;
  }
  .studio-screening-title {
    font-family: var(--f-display);
    font-size: clamp(25px, 2.7vw, 38px);
    line-height: 1.02;
    text-wrap: balance;
  }
  .studio-screening-summary {
    max-width: 52ch;
    color: var(--paper-dim);
    font-size: 15px;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .studio-screening-arrow {
    position: absolute;
    right: 3px;
    bottom: 20px;
    color: var(--studio-amber);
    font-size: 22px;
    transition: transform .35s;
  }
  @media (hover: hover) {
    .studio-screening:hover { border-color: var(--take-colour); }
    .studio-screening:hover .studio-screening-arrow { transform: translate(3px,-3px); }
  }
  .studio-empty {
    padding: 20px 0 12px;
    border-bottom: 1px solid rgba(236,228,210,.18);
    color: var(--paper-dim);
  }
  .studio-empty .mono { color: var(--studio-pink); font-size: 10px; letter-spacing: .15em; }
  .studio-empty p { margin: 8px 0 0; }
  .studio-footline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
    margin-top: 19px;
    color: var(--muted);
    font-size: 9px;
    letter-spacing: .15em;
  }

  @media (max-width: 900px) {
    .studio-feature { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .studio-copy { max-width: 68ch; }
    .studio-art { width: 100%; aspect-ratio: 16 / 9; }
    .studio-screenings { gap: 18px; }
  }
  @media (max-width: 600px) {
    .studio-cut { padding-block: 54px 62px; }
    .studio-shell { padding-inline: clamp(16px, 5vw, 24px); }
    .studio-topline .mono { font-size: 9px; letter-spacing: .12em; }
    .studio-feature { padding-block: 26px 30px; gap: 24px; }
    .studio-copy h2 { font-size: clamp(54px, 15vw, 72px); }
    .studio-subtitle { margin: 13px 0 18px; }
    .studio-method { font-size: 9px; letter-spacing: .08em; }
    .studio-enter { font-size: 10px; }
    .studio-art { aspect-ratio: 4 / 3; }
    .studio-meter { padding: 11px 9px 12px; }
    .studio-meter-head { font-size: 9px; }
    .studio-counter { min-height: 36px; }
    .studio-counter-numbers li { font-size: 10px; }
    .studio-playhead { width: 12px; height: 12px; }
    .studio-reel-head { align-items: flex-start; }
    .studio-reel-head h3 { font-size: 34px; }
    .studio-all-link { font-size: 9px; white-space: nowrap; }
    .studio-screenings { grid-template-columns: 1fr; gap: 0; }
    .studio-screening { min-height: 0; padding: 17px 32px 20px 0; }
    .studio-footline { font-size: 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .studio-playhead { animation: none; left: 50%; }
    .studio-enter, .studio-enter-arrow, .studio-all-link span, .studio-screening, .studio-screening-arrow { transition: none; }
  }
</style>
