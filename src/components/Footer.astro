---
import Icon from './Icon.astro';
import Frame from './Frame.astro';
import { cfg, href, tales, newestFirst, pad, shortDate } from '../lib/site';
import { sides } from '../lib/kolkata';
const year = new Date().getFullYear();
// the destination board: five Kolkata stops, running in a loop
const stops = ['Howrah', 'Esplanade', 'College Street', 'Park Street', 'Kalighat'];
// the four newest tales; while there are fewer than four, the last card points to the archive
const still = newestFirst.slice(0, 4);
const showArchiveCard = still.length < 4;
---
<footer class="site-footer">
  <div class="board" aria-hidden="true" data-board>
    <div class="track">
      {[0, 1, 2].map(() => (
        <div class="seq">
          {stops.map((s, i) => (<><span class={i === 0 ? 'stop hl' : 'stop'}>{s}</span><Icon name="tram" /></>))}
        </div>
      ))}
    </div>
  </div>

  <section class="wrap still" aria-labelledby="still-title">
    <div class="still-head">
      <h2 id="still-title">Still on the line</h2>
      <a class="ulink mono" href={href('tales/')} data-cursor="link">All {pad(tales.length)} {tales.length === 1 ? 'tale' : 'tales'} &rarr;</a>
    </div>
    <div class="still-grid">
      <Frame frame={sides[0]} class="still-side" widths={[300, 600]} sizes="(max-width: 860px) 50vw, 15vw" />
      <div class="still-board" data-zip>
        <ul class="still-cards" role="list">
          {still.map((t) => (
            <li style={`--c:${t.colour}`}>
              <a href={href(t.path)} data-cursor="Read" data-wipe={t.colour} data-wipe-to={t.title}>
                <span class="mono no">No. {pad(t.no)} · {shortDate(t.date)}</span>
                <span class="t">{t.title}</span>
                <span class="mono tag">{t.tag ? `${t.tag} · ` : ''}{t.minutes} min</span>
              </a>
            </li>
          ))}
          {showArchiveCard && (
            <li class="to-archive">
              <a href={href('tales/')} data-cursor="link">
                <span class="mono no">The depot</span>
                <span class="t">Next stop: the archive &rarr;</span>
                <span class="mono tag">{pad(tales.length)} {tales.length === 1 ? 'tale' : 'tales'} so far</span>
              </a>
            </li>
          )}
        </ul>
        <div class="zipper" aria-hidden="true">
          <span class="teeth"></span>
          <svg class="pull" viewBox="0 0 24 52" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
            <path d="M5 2h14l-2 14H7z" fill="currentColor" fill-opacity="0.18" />
            <path d="M9 16v6M15 16v6" />
            <rect x="6" y="22" width="12" height="28" rx="6" fill="currentColor" fill-opacity="0.12" />
            <rect x="9.5" y="27" width="5" height="12" rx="2.5" />
          </svg>
        </div>
      </div>
      <Frame frame={sides[1]} class="still-side" widths={[300, 600]} sizes="(max-width: 860px) 50vw, 15vw" />
    </div>
  </section>

  <div class="wrap foot-row">
    <div class="signature">
      <p class="sig-mark" aria-label={cfg.name}><span aria-hidden="true"><span class="dv" lang="hi">ट</span>ramline <em><span class="dv" lang="hi">ट</span>ales</em></span></p>
      <p class="mono sig-line">— {cfg.initials} · Written in {cfg.stampPlace}, over kadak chai</p>
    </div>
    <div>
      <h3 class="mono">Timetable</h3>
      <p><span class="days-full">{cfg.days.join(' · ')}</span><span class="days-short">{cfg.days.map((d) => d.slice(0, 3)).join(' · ')}</span></p>
    </div>
    <div>
      <h3 class="mono">Depot</h3>
      <p><span class="place">{cfg.place}</span></p>
    </div>
    <div class="to-top-wrap">
      <button class="to-top mono" type="button" data-to-top data-cursor="link"><Icon name="rickshaw" />Pull back to the top</button>
    </div>
  </div>
  <div class="wrap foot-base mono">
    <span>© {year} {cfg.author}</span>
    <span>Old tracks, new thoughts.</span>
  </div>
</footer>
