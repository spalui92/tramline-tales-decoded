---
// A list of tales: big typographic rows, each with its photo pinned as a
// postcard (shown inline on phones, following the pointer on desktop).
import { Image } from 'astro:assets';
import Clip from './Clip.astro';
import { SECTIONS, href, shortDate, pad, type Tale } from '../lib/site';

interface Props { items: Tale[]; showKind?: boolean; hoverPreview?: boolean; mixed?: boolean }
// mixed: the list holds pieces from more than one line, so every row names its line, both in the number
// ("Tale No. 09", "Take No. 02") and beside its date ("Tales · 22.11.26", "Hot Takes · 23.11.26")
const { items, showKind = false, hoverPreview = true, mixed = false } = Astro.props;
const lean = [-2.2, 1.8, -1.2, 2.4];
const fit = (w: number, list: number[]) => { const ok = list.filter((x) => x <= w); return ok.length ? ok : [w]; };
---
<ol class:list={["tale-list", { "with-peek": hoverPreview, mixed }]}>
  {items.map((t, i) => (
    <li class="tale-row" style={`--c:${t.colour}`} data-row={t.slug} data-reveal>
      <a href={href(t.path)} data-cursor="Read" data-wipe={t.colour} data-wipe-to={t.title}>
        {(t.cover || t.slug === '2026-11-28') && t.kind !== 'depot' && (
          <span class="thumb"><span class="pinned" style={`--r:${lean[i % lean.length]}deg`}><Clip />{t.slug === '2026-11-28' ? <img src="https://upload.wikimedia.org/wikipedia/commons/4/4b/Federer_serves_on_clay.jpg" alt="Roger Federer serving on clay at the 2016 Italian Open. Photograph by JC, CC BY-SA 2.0." loading="lazy" /> : <Image src={t.cover!.image} alt="" widths={fit(t.cover!.image.width, [480, 900])} sizes="86vw" loading="lazy" />}</span></span>
        )}
        <span class="no mono">{showKind || mixed ? `${SECTIONS[t.kind].singular} ` : ''}No. {pad(t.no)}</span>
        <span class="t">{t.title}</span>
        <span class="d mono">{mixed && <><b class="kind">{SECTIONS[t.kind].label}</b> · </>}<time datetime={t.date}>{shortDate(t.date)}</time></span>
        <span class="sum">{t.summary}</span>
      </a>
    </li>
  ))}
</ol>
{hoverPreview && <div class="peek" aria-hidden="true" data-peek>
  {items.map((t, i) => (t.cover || t.slug === '2026-11-28') && t.kind !== 'depot' && (
    <div class="pinned peek-card" data-peek-img={t.slug} style={`--c:${t.colour};--r:${lean[i % lean.length]}deg`}>
      <Clip />{t.slug === '2026-11-28' ? <img src="https://upload.wikimedia.org/wikipedia/commons/4/4b/Federer_serves_on_clay.jpg" alt="Roger Federer serving on clay at the 2016 Italian Open." loading="eager" /> : <Image src={t.cover!.image} alt={`Preview for ${t.title}`} widths={fit(t.cover!.image.width, [640, 1000])} sizes="320px" loading="eager" decoding="async" />}
    </div>
  ))}
</div>}
