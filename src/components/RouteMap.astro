---
// The route map: three lines running out of the depot, one stop for every piece published.
// Tales is the main line; Depot Files and the Notice Board are branches. Each line is a window
// onto its stops: three show at a time, and once a line grows past three it can be swiped or
// stepped with the arrows. A line with nothing on it yet shows a dashed track and its next stop.
import Icon from './Icon.astro';
import { SECTIONS, KINDS, COLOURS, byKind, href, pad } from '../lib/site';

const MAX = 12; // stops drawn per line; older ones fold into a "+N earlier" stop
const lines = KINDS.map((k, i) => {
  const sec = SECTIONS[k];
  const all = byKind(k);
  const shown = all.slice(-MAX);
  const colour = k === 'tale' ? COLOURS.sindoor.hex : COLOURS[sec.defaultColour].hex;
  return { k, sec, all, shown, hidden: all.length - shown.length, colour, no: i + 1 };
});
---
<section class="section wrap routes" id="routes" aria-labelledby="routes-title">
  <div class="routes-head">
    <div class="rm-head-copy">
      <div class="eyebrow mono">The route map</div>
      <h2 id="routes-title" data-split>Three lines, <em>one depot.</em></h2>
      <p data-reveal>Tales are the main line. Two branches run off it: campaign teardowns taken apart in the depot, and notices pinned up the way a company would. Every dot is a stop you can get off at.</p>
    </div>
    <ol class="rm-podium" role="list" aria-label="Order of preference: Tales first, Depot Files second, Notice Board third" data-reveal>
      {[lines[1], lines[0], lines[2]].map((l) => {
        const rank = l.k === 'tale' ? 1 : l.k === 'depot' ? 2 : 3;
        return (
          <li class={`rm-pod rm-pod-${rank}`} style={`--c:${l.colour}`}>
            <a class="rm-pod-link" href={href(`${l.sec.dir}/`)} data-cursor="link">
              <span class="rm-placard">
                <span class="mono rm-placard-no">Box No. {rank}</span>
                <b class="rm-placard-name">{l.sec.label}</b>
              </span>
              <span class="rm-box" aria-hidden="true"><span class="rm-box-n">{rank}</span></span>
            </a>
          </li>
        );
      })}
    </ol>
  </div>
  <ol class="rm-lines" role="list">
    {lines.map((l) => (
      <li class={`rm-line rm-line-${l.k}${l.all.length === 0 ? ' is-empty' : ''}`} style={`--c:${l.colour}`} data-reveal data-rm>
        <a class="rm-name" href={href(`${l.sec.dir}/`)} data-cursor="link">
          <span class="mono rm-ln">Line {pad(l.no)}</span>
          <b>{l.sec.label}</b>
          <span class="mono rm-lc">{pad(l.all.length)} {l.all.length === 1 ? 'stop' : 'stops'} &rarr;</span>
        </a>
        <div class="rm-pager" data-pager hidden>
          <button type="button" data-dir="-1" aria-label={`${l.sec.label}: earlier stops`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 6 8.5 12l6 6" /></svg>
          </button>
          <button type="button" data-dir="1" aria-label={`${l.sec.label}: later stops`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9.5 6 6 6-6 6" /></svg>
          </button>
        </div>
        <div class="rm-scroll" data-scroll tabindex="0" role="group" aria-label={`${l.sec.label}: stops, scrollable`}>
          <ul class="rm-stops" role="list">
            {l.hidden > 0 && (
              <li class="rm-stop rm-earlier"><a href={href(`${l.sec.dir}/`)} data-cursor="link"><span class="rm-dot" aria-hidden="true"></span><span class="rm-lbl mono"><span class="rm-no">Earlier</span><span class="rm-title">+{l.hidden} more in the archive</span></span></a></li>
            )}
            {l.shown.map((p, i) => {
              const last = i === l.shown.length - 1;
              return (
                <li class={`rm-stop${last ? ' is-newest' : ''}`}>
                  <a href={href(p.path)} data-cursor="Read" data-wipe={p.colour} data-wipe-to={p.title} title={p.title}>
                    {last && <Icon name="tram" class="rm-tram" />}
                    <span class="rm-dot" aria-hidden="true"></span>
                    <span class="rm-lbl mono"><span class="rm-no">No. {pad(p.no)}</span><span class="rm-title">{p.title}</span></span>
                  </a>
                </li>
              );
            })}
            {l.all.length === 0 && (
              <li class="rm-stop rm-soon"><a href={href(`${l.sec.dir}/`)} data-cursor="link"><span class="rm-dot" aria-hidden="true"></span><span class="rm-lbl mono"><span class="rm-no">Next stop</span><span class="rm-title">{l.sec.empty}</span></span></a></li>
            )}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</section>

<script>
  // Each line is a window onto its stops. It opens on the first stop (01); the arrows and the edge
  // fades only appear when there is more to see (more than three stops).
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-rm]').forEach((line) => {
    const sc = line.querySelector<HTMLElement>('[data-scroll]');
    const pg = line.querySelector<HTMLElement>('[data-pager]');
    if (!sc || !pg) return;
    const prev = pg.querySelector<HTMLButtonElement>('[data-dir="-1"]')!;
    const next = pg.querySelector<HTMLButtonElement>('[data-dir="1"]')!;
    const update = () => {
      const max = sc.scrollWidth - sc.clientWidth;
      const over = max > 2;
      const atStart = sc.scrollLeft <= 2;
      const atEnd = sc.scrollLeft >= max - 2;
      pg.hidden = !over;
      sc.classList.toggle('can-l', over && !atStart);
      sc.classList.toggle('can-r', over && !atEnd);
      prev.disabled = atStart;
      next.disabled = atEnd;
    };
    pg.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!b) return;
      sc.scrollBy({ left: Number(b.dataset.dir) * sc.clientWidth * 0.67, behavior: reduced ? 'auto' : 'smooth' });
    });
    sc.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(sc);
    sc.scrollLeft = 0;
    update();
  });
</script>
