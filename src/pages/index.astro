---
import Base from '../layouts/Base.astro';
import Bridge from '../components/Bridge.astro';
import Highway from '../components/Highway.astro';
import TaleList from '../components/TaleList.astro';
import Frame from '../components/Frame.astro';
import Heartbeat from '../components/Heartbeat.astro';
import RouteMap from '../components/RouteMap.astro';
import Icon from '../components/Icon.astro';
import Clip from '../components/Clip.astro';
import { Image } from 'astro:assets';
import { cfg, tales, newestFirst, depotFiles, notices, href, absolute, shortDate, pad } from '../lib/site';
import { windows } from '../lib/kolkata';

const latest = newestFirst[0];
const recent = newestFirst.slice(0, 3);
const latestDepot = depotFiles[depotFiles.length - 1];
const latestNotice = notices[notices.length - 1];

const jsonld = {
  '@context': 'https://schema.org', '@type': 'Blog', name: cfg.name, description: cfg.description,
  url: absolute(), author: { '@type': 'Person', name: cfg.author },
  blogPost: tales.map((t) => ({ '@type': 'BlogPosting', headline: t.title, datePublished: t.date, description: t.summary, url: absolute(t.path), author: { '@type': 'Person', name: cfg.author } })),
};
---
<Base page="home" wire jsonld={jsonld}>
  <!-- HERO: Howrah Bridge across the night, and a highway rolling out beneath it to the reader,
       with the masthead set on the road (desktop: the bridge runs edge to edge; phones: the centre span) -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="river-fallback" aria-hidden="true"></div>
    <canvas class="river" aria-hidden="true" data-river></canvas>
    <Bridge class="bridge wide" span={2600} />
    <Bridge class="bridge wide mirror" mirror span={2600} />
    <Bridge class="bridge narrow" />
    <Bridge class="bridge narrow mirror" mirror />
    <Highway variant="wide" />
    <Highway variant="phone" />
    <div class="hero-inner">
      <div class="masthead">
        <h1 class="hero-title" id="hero-title">
          <span class="sr">Tramline Tales</span>
          <!-- the lockup: TRAMLINE in condensed caps with a tram standing in for the I; below it, Tales in a
               light italic whose T is a tram pole, its crossbar running on as the overhead wire -->
          <svg class="lockup" data-hero-line viewBox="0 0 270 112" aria-hidden="true" focusable="false">
            <text class="lk-caps" x="0" y="40" textLength="98" lengthAdjust="spacingAndGlyphs">TRAML</text>
            <g class="lk-tram" transform="translate(102 12) scale(0.6538 0.6667)">
              <rect x="0" y="1" width="26" height="2" class="gold" />
              <path d="M13 3 L7 11 M13 3 L19 11" class="wire" />
              <rect x="3" y="10" width="20" height="28" rx="2" class="body" />
              <rect x="6" y="12" width="14" height="4" rx="1" class="glass" />
              <rect x="6" y="18" width="6" height="10" rx="1" class="glass" />
              <rect x="14" y="18" width="6" height="10" rx="1" class="glass" />
              <rect x="3" y="30" width="20" height="2" class="gold" />
              <circle cx="13" cy="35" r="1.6" class="lamp-red" />
              <rect x="0" y="39" width="26" height="2" class="gold" />
            </g>
            <text class="lk-caps" x="123" y="40" textLength="38" lengthAdjust="spacingAndGlyphs">NE</text>
            <g class="lk-pole" transform="translate(98 108) skewX(-11)">
              <line x1="0" y1="-56" x2="155" y2="-56" />
              <line x1="0" y1="-56" x2="0" y2="-45" />
              <rect x="20" y="-56" width="6" height="56" />
              <line x1="12" y1="-1.5" x2="34" y2="-1.5" />
              <circle class="lk-signal" cx="155" cy="-56" r="3.4" />
            </g>
            <text class="lk-script" x="138" y="108" textLength="118" lengthAdjust="spacing">ales</text>
          </svg>
        </h1>
        <p class="kicker" data-reveal><span class="bn" lang="bn" data-text="ট্রামলাইনের টুকিটাকি"><span class="bn-initial">ট্রা</span>মলাইনের টুকিটাকি</span><span class="sep" aria-hidden="true">·</span><span class="en tagline-typewriter">Old tracks, new thoughts.</span></p>
      </div>
    </div>
  </section>

  <!-- THE SCOREBOARD: the newest tale, straight after the masthead -->
  <section class="scoreboard" style={`--c:${latest.colour}`} aria-label="Latest tale">
    <div class="wrap editorial-rule mono" aria-hidden="true"><span>TRAMLINE TALES</span><span class="editorial-rule-center">THE FRONT PAGE</span><span>EST. KOLKATA</span></div>
    <div class="wrap sb">
      <span class="sb-meta mono" data-reveal><b>Latest · Tale No. {pad(latest.no)}</b><span>{shortDate(latest.date)}</span>{latest.tag && <span>{latest.tag}</span>}</span>
      <a class="sb-main" href={href(latest.path)} data-cursor="Read" data-wipe={latest.colour} data-wipe-to={latest.title}>
        <span class="sb-title" data-reveal>{latest.title}</span>
        <span class="sb-side" data-reveal>
          <span class="sb-sum">{latest.summary}</span>
          <span class="sb-cta mono">Board here <span aria-hidden="true">&rarr;</span></span>
        </span>
      </a>
      <div class="sb-desk">
        <span class="sb-ghost" aria-hidden="true">{pad(latest.no)}</span>
        {latest.cover && (
          <a class="sb-cardlink" href={href(latest.path)} tabindex="-1" aria-hidden="true" data-cursor="Read" data-wipe={latest.colour} data-wipe-to={latest.title}>
            <figure class="postcard sb-card" style={`--r:2.2deg;--clip:${latest.colour};--cx:62%`}>
              <div class="card">
                <Clip class="pclip" />
                <div class="img"><Image src={latest.cover.image} alt="" widths={[480, 800]} sizes="400px" loading="eager" /></div>
                <figcaption>{latest.cover.caption.replace(/\s*\([^)]*\)\s*$/, '')}</figcaption>
              </div>
            </figure>
          </a>
        )}
      </div>
    </div>
    <div class="zip-rule" aria-hidden="true" data-zip-rule>
      <span class="zr-track"></span>
      <Icon name="tram" class="zr-tram" />
      <span class="zr-ting">ting ting</span>
    </div>
    <div class="wrap ticket-section" data-reveal>
      <div class="ticket-heading"><div><span class="mono ticket-overline">MORE STOPS ALONG THE LINE</span><h2>Also running</h2></div><svg class="ticket-tram-sketch" viewBox="0 0 260 150" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 126H245M32 132H252M55 118L48 136M95 118L89 136M135 118L129 136M175 118L169 136M215 118L209 136" stroke-width="1.1" opacity=".55"/>
          <path d="M45 102L48 44Q49 37 58 35L191 28Q203 28 208 38L216 105L45 110Z" stroke-width="2"/>
          <path d="M56 43L194 36M55 49L55 95M206 47L211 96M44 101L215 97M44 110L216 105" stroke-width="1.4"/>
          <path d="M67 49L195 44L201 85L62 91Z" stroke-width="1.3"/>
          <path d="M97 47L95 89M132 46L132 87M168 45L170 86M63 92L204 87M49 100L214 96" stroke-width="1.2"/>
          <path d="M56 33L62 24L189 18L199 28M105 23L111 9L145 7L151 21M128 8L133 1M130 2L172 1" stroke-width="1.4"/>
          <path d="M66 112L68 121L84 124L90 111M171 109L174 119L191 119L196 107" stroke-width="1.8"/>
          <path d="M43 105L37 108L36 116M216 102L226 103L228 111M69 57L89 56M139 55L161 53M178 53L194 52" stroke-width=".8"/>
          <path d="M17 140H253" stroke-width="1" stroke-dasharray="5 6"/>
          <circle cx="76" cy="114" r="2.5" fill="currentColor"/><circle cx="183" cy="111" r="2.5" fill="currentColor"/>
        </g>
      </svg></div>
      <div class="ticket-stack">
        {latestDepot
          ? <a class="route-ticket ticket-depot" href={href(latestDepot.path)} data-cursor="Read" data-wipe={latestDepot.colour} data-wipe-to={latestDepot.title}>
              <span class="ticket-stub"><strong>{pad(latestDepot.no)}</strong><span class="mono">DEPOT<br />FILES</span></span>
              <span class="ticket-body"><span class="mono ticket-category">THE BRAND AUTOPSY</span><span class="ticket-title">{latestDepot.title}</span><span class="ticket-description">A closer look behind the creative work.</span></span>
              <span class="ticket-arrow" aria-hidden="true">↗</span>
            </a>
          : <a class="route-ticket ticket-depot" href={href('depot/')} data-cursor="link"><span class="ticket-stub"><strong>02</strong><span class="mono">DEPOT<br />FILES</span></span><span class="ticket-body"><span class="mono ticket-category">THE BRAND AUTOPSY</span><span class="ticket-title">First teardown coming soon</span></span><span class="ticket-arrow" aria-hidden="true">↗</span></a>}
        {latestNotice
          ? <a class="route-ticket ticket-notice" href={href(latestNotice.path)} data-cursor="Read" data-wipe={latestNotice.colour} data-wipe-to={latestNotice.title}>
              <span class="ticket-stub"><strong>{pad(latestNotice.no)}</strong><span class="mono">NOTICE<br />BOARD</span></span>
              <span class="ticket-body"><span class="mono ticket-category">PLATFORM DISPATCH</span><span class="ticket-title">{latestNotice.title}</span><span class="ticket-description">A dispatch from the platform.</span></span>
              <span class="ticket-arrow" aria-hidden="true">↗</span>
            </a>
          : <div class="route-ticket ticket-notice is-upcoming" aria-label="Notice Board: first dispatch coming soon">
              <span class="ticket-stub"><strong>03</strong><span class="mono">NOTICE<br />BOARD</span></span>
              <span class="ticket-body"><span class="mono ticket-category">PLATFORM DISPATCH</span><span class="ticket-title">Dispatches from the platform</span><span class="ticket-description">First dispatch coming soon.</span></span>
              <span class="ticket-soon mono">SOON</span>
            </div>}
      </div>
    </div>
  </section>

  <!-- THE LATEST THREE TALES -->
  <section class="section wrap latest" id="tales" aria-labelledby="tales-title">
    <div class="tales-head">
      <h2 id="tales-title" data-split>Latest tales</h2>
      <span class="mono" style="color:var(--muted)">{pad(recent.length)} of {pad(tales.length)}</span>
    </div>
    <TaleList items={recent} />
    <a class="archive-cta" href={href('tales/')} data-cursor="link">
      <span class="mono">Next stop: the archive</span>
      <span class="arr" aria-hidden="true">&rarr;</span>
      <span class="mono count">{pad(tales.length)} {tales.length === 1 ? 'tale' : 'tales'}</span>
    </a>
  </section>

  <!-- THE ROUTE MAP: the two branch lines, one stop for every piece -->
  <RouteMap />

  <!-- ABOUT THE DIARY, AND THE DIARY AT A GLANCE -->
  <section class="section wrap about" id="about" aria-labelledby="about-title">
    <div>
      <div class="eyebrow mono">About the diary</div>
      <h2 id="about-title" data-split>Notes from the <em>window seat.</em></h2>
    </div>
    <div class="copy" data-reveal>
      <p>Some cities stay behind when you leave them. Kolkata doesn't. It follows you home in the rattle of tracks, the yellow flash of a taxi, the half-heard sales pitch from a television set. Tramline Tales lives somewhere in that afterglow, where ordinary things begin to look slightly more interesting.</p>
      <p>These are notes from the window seat: brands behaving like stories, media behaving like memory, and marketing hiding in plain sight. Nothing here is too ordinary to question. Some stops are brief. Some thoughts stay with you long after the tram has moved on.</p>
      <Heartbeat />
    </div>
  </section>

  <!-- KOLKATA BYLANES: five detours off the line -->
  <section class="section wrap windows" aria-labelledby="win-title">
    <div class="win-head">
      <h2 id="win-title" data-split>Kolkata <em>Bylanes</em><span class="sub">five detours off the line</span></h2>
      <div class="win-intro" data-reveal>
        <p>Not the postcard Kolkata. Five things this city keeps handing back to me, long after the tram has turned the corner.</p>
        <p>No archive. No endless scroll. Just five.</p>
      </div>
    </div>
    <ul class="win-grid" role="list">
      {windows.map((w, i) => (
        <li class={`win win-${i + 1}`} data-reveal>
          <figure>
            <Frame frame={w} widths={[400, 700, 1000]} sizes="(max-width: 760px) 50vw, 20vw" />
            <figcaption><span class="mono">Bylane {pad(i + 1)}</span><b>{w.place}</b><span class="note">{w.note}</span></figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
  // The zipper zips across the page the first time it scrolls into view (skipped for reduced motion).
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-zip-rule]').forEach((z) => {
      z.classList.add('pre');
      new IntersectionObserver((entries, io) => {
        entries.forEach((e) => { if (e.isIntersecting) { z.classList.remove('pre'); io.disconnect(); } });
      }, { threshold: 0.6 }).observe(z);
    });
  }
</script>
